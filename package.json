{
  "name": "budgy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "build:android": "vite build && cap sync android",
    "build:ios": "vite build && cap sync ios",
    "android:apk:debug": "node scripts/android-build.mjs assembleDebug",
    "android:apk:release": "node scripts/android-build.mjs assembleRelease",
    "android:aab:release": "node scripts/android-build.mjs bundleRelease",
    "android:build:all": "vite build && cap sync android && node scripts/android-build.mjs assembleDebug && node scripts/android-build.mjs bundleRelease",
    "start": "vite --open",
    "build:prod": "npm run build",
    "ios:sync": "npm run build:prod && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "android:sync": "npm run build:prod && npx cap sync android",
    "android:build": "npm run android:sync && node scripts/android-build.mjs assembleDebug && node scripts/android-build.mjs bundleRelease",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "analyze": "npx vite-bundle-visualizer@1.2.1",
    "lighthouse": "npx lighthouse@13.6.0 http://localhost:5175 --view"
  },
  "dependencies": {
    "@budgy/sms-inbox": "file:plugins/sms-inbox",
    "@capacitor/android": "~8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "~8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "~8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "8.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@ionic/react": "^8.0.0",
    "@ionic/react-router": "^8.0.0",
    "@supabase/supabase-js": "2.118.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^26.2.0",
    "ionicons": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.3",
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "6.2.5",
    "sharp": "^0.34.5",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^3.2.7"
  }
}
