# Secrets for the Supabase CLI (config.toml reads them with env(...)). Copy to supabase/.env, which git
# ignores. These are server-side settings: they never go into the app.

# Google Cloud → Credentials. Web client ID first, then iOS and Android client IDs, comma-separated.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# The Web client's secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# The iOS bundle ID (com.budgy.app). For Apple on the web too: the Services ID first, then the bundle ID.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.budgy.app
# Only for Apple sign-in on the web: the secret generated from your .p8 key (renew every 6 months).
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
