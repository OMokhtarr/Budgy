# Copy to .env and fill in to turn on sign-in and cloud sync. Leave empty for an offline-only build.
# Never put the secret / service_role key here: everything in this file ends up inside the app.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud → APIs & Services → Credentials (OAuth client IDs)
# The *Web application* client ID (also used by Android's native sign-in).
VITE_GOOGLE_WEB_CLIENT_ID=
# The iOS client ID.
VITE_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple on the web build (needs an Apple Services ID in Supabase). iOS always offers it.
VITE_APPLE_SIGN_IN_WEB=false
