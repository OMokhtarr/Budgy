# Copy to .env and fill in to turn on sign-in and cloud sync. Leave empty for an offline-only build.
# Never put the secret / service_role key here: everything in this file ends up inside the app.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud → APIs & Services → Credentials (OAuth client IDs)
# The *Web application* client ID (also used by Android's native sign-in).
VITE_GOOGLE_WEB_CLIENT_ID=
# The iOS client ID.
VITE_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple on the web build (needs an Apple Services ID in Supabase). iOS always offers it.
VITE_APPLE_SIGN_IN_WEB=false

# RevenueCat → Project → API keys. These are public SDK keys (they ship inside the app), not secret keys.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
# Budgy Pro switch: off (or empty) = no paywall, RevenueCat never starts; test = paywall and purchases work but
# nothing is locked; on = Pro gates cloud sync and other Pro features. Needs the platform's key and a native app.
VITE_PRO_GATE=off
